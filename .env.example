# Copy this file to .env and fill in values as needed.
# Never commit a real .env file.

# --- LLM ---
# Local or remote endpoint for LiquidAI/LFM2.5-1.2B-Instruct (set when wiring the model)
LLM_MODEL_ID=LiquidAI/LFM2.5-1.2B-Instruct
# LLM_API_BASE=
# LLM_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# --- Paths ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
CHROMA_PERSIST_DIR=chroma_db

# --- App ---
# Airport focus for early development (informational; not a data source by itself)
DEFAULT_AIRPORT=RUH
LOG_LEVEL=INFO

# --- Flights (Phase 2) ---
# Public KKIA departures/arrivals page and same-origin JSON feed used by that page.
# Do not poll continuously; use occasional on-demand requests only.
FLIGHTS_PAGE_URL=https://www.kkia.sa/en/Flights/Departures-and-Arrivals
FLIGHTS_API_URL=https://www.kkia.sa/api/flightsInformation
